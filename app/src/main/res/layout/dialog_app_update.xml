<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp"
            android:gravity="center_horizontal">

            <!-- Top Close/Dismiss Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvUpdateBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OTA UPDATE"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_centerVertical="true" />

                <ImageButton
                    android:id="@+id/btnCloseUpdateDialog"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_card"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/text_secondary"
                    android:contentDescription="Dismiss update"
                    android:padding="8dp" />
            </RelativeLayout>

            <!-- App Logo Icon -->
            <ImageView
                android:id="@+id/ivUpdateLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_oskar_logo"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_card"
                android:padding="6dp"
                android:clipToOutline="true"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="OskarSMS Logo" />

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cusbooneysiin Cusub! 🚀"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/tvUpdateSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nooc cusub oo OskarSMS ah ayaa diyaar ah"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:textAlignment="center" />

            <!-- Version Pill Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvCurrentVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.1.3"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ➔  "
                    android:textColor="@color/primary_light"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNewVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.1.4"
                    android:textColor="@color/emerald"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Changelog Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waxyaabaha Cusub (What's New):"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvChangelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• In-App Self-Updating Engine\n• Direct install unknown sources flow\n• Real-time download progress bar\n• Background update notifications"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Install Permission Status Card -->
            <LinearLayout
                android:id="@+id/layoutPermissionNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_active"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvPermissionIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvPermissionStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Install Source Permission: Ready"
                    android:textColor="@color/emerald"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Download Progress Container (initially GONE) -->
            <LinearLayout
                android:id="@+id/layoutDownloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                tools:visibility="visible">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvProgressStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Soo dejinaya update-ka..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProgressPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0%"
                        android:textColor="@color/primary_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Modern Progress Bar -->
                <ProgressBar
                    android:id="@+id/progressBarUpdate"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/surface_container" />

                <TextView
                    android:id="@+id/tvProgressBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 MB / 0 MB"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Primary Action Button (Update Now / Install) -->
            <Button
                android:id="@+id/btnActionUpdate"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🚀 CUSBOONEYSII HADDA (UPDATE NOW)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="14dp"
                android:layout_marginBottom="12dp" />

            <!-- Dismiss Later Link -->
            <TextView
                android:id="@+id/btnDismissUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dib U Dhig (Later)"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:padding="8dp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
