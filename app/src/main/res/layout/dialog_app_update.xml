<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A14">

    <!-- 1xBet Full-Screen Background Image -->
    <ImageView
        android:id="@+id/ivUpdateBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_update_screen"
        android:contentDescription="Update background" />

    <!-- Bottom Legibility Scrim Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <!-- Bottom Action & Status Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- What's New Expandable Card (Initially GONE) -->
        <LinearLayout
            android:id="@+id/layoutChangelogCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_whats_new_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvVersionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="What's new in this version:"
                    android:textColor="#38BDF8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseChangelog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="✕"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChangelogContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:text="• Performance improvements and bug fixes." />
        </LinearLayout>

        <!-- Idle / Ready to Update State Container -->
        <LinearLayout
            android:id="@+id/layoutIdleState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 1xBet Header Text -->
            <TextView
                android:id="@+id/tvPromptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A new version of the app is available, press\n\"Update\" to install"
                android:textColor="#CBD5E1"
                android:textSize="15sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="24dp" />

            <!-- What's new? Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnWhatsNew"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="What's new?"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_btn_whats_new"
                android:layout_marginBottom="12dp" />

            <!-- Primary Update Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUpdate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Update"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_btn_update_primary" />
        </LinearLayout>

        <!-- Downloading State Container (Matches 1xBet Screenshot 6) -->
        <LinearLayout
            android:id="@+id/layoutDownloadingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Label and Percentage Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDownloadingLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Downloading update..."
                    android:textColor="#CBD5E1"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDownloadPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#CBD5E1"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thin Sleek Horizontal Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBarUpdate"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/bg_progress_horizontal" />
        </LinearLayout>

        <!-- Error State Container -->
        <LinearLayout
            android:id="@+id/layoutErrorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download interrupted. Tap retry to continue."
                android:textColor="#F87171"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Retry"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_btn_update_primary" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
